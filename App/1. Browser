javascript: (function () {
  let C = 'd',
    S = 'c-ns',
    $ = e => document.querySelectorAll(e);

  $('.' + C + ',#' + S).forEach(e => e.remove());

  let css = document.createElement('style');
  css.id = S;
  css.textContent = `html,body{background-color:#000!important;color-scheme:dark!important}:is(header,footer,[role=banner],[role=contentinfo],[class*="header" i],[class*="footer" i]):not([class*="player" i],[class*="video" i],[class*="control" i],.${C}):not(:has(video,iframe)){display:none!important}.${C}{all:initial!important;font:14.5px system-ui,sans-serif!important;background:#121212f2!important;backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important;border:1px solid #ffffff26!important;border-radius:34px!important;box-shadow:0 9px 32px #000d!important;display:flex!important;align-items:center!important;position:fixed!important;bottom:18px!important;left:50%!important;transform:translateX(-50%)!important;width:max-content!important;max-width:calc(100vw - 24px)!important;z-index:2147483647!important;padding:8px 14px!important;gap:12px!important;overflow-x:auto!important;box-sizing:border-box!important}.${C}::-webkit-scrollbar{display:none!important}.${C} :is(a,button,div){color:#fff!important;background:0 0!important;border:0!important;outline:0!important;text-decoration:none!important;display:flex!important;align-items:center!important;justify-content:center!important;cursor:pointer!important;white-space:nowrap!important;padding:9px!important;border-radius:50%!important;width:44px!important;height:44px!important;flex-shrink:0!important;margin:0!important;box-sizing:border-box!important}.${C} :is(a,button,div):not(:has(svg)){border-radius:20px!important;width:auto!important;padding:8px 14px!important;font-weight:500!important}.${C} svg{width:21px!important;height:21px!important;stroke:currentColor!important;fill:none!important;flex-shrink:0!important}`;
  document.head.appendChild(css);

  let B = (e, v) => e.style.setProperty('background', v, 'important'),
    u = () => {
      B(document.body, '#000');
      $('div,article').forEach(e => {
        if (e.matches('.' + C)) return;
        if (e.querySelector('video,iframe') || e.closest('[class*="player" i],[class*="video" i],[class*="control" i]')) {
          e.style.removeProperty('background');
          return;
        }
        getComputedStyle(e).backgroundImage !== 'none' ? e.style.removeProperty('background') : B(e, 'transparent');
      });
    };
  u();
  setInterval(u, 2000);

  let d = document.createElement('div');
  d.className = C;

  let x = 0, y = 0, m = 0;
  d.onpointerdown = e => { x = e.clientX; y = e.clientY; m = 0; };
  d.onpointermove = e => { if (Math.hypot(e.clientX - x, e.clientY - y) > 8) m = 1; };
  d.onclick = e => {
    if (m) return;
    let el = e.target.closest('a,button,div');
    if (!el || el === d) return;
    e.preventDefault();
    navigator.vibrate && navigator.vibrate(15);
    el.tagName === 'A' ? (el._el ? el._el.click() : location.href = el.href) : el.click();
  };

  let g = t => (p => p ? `<svg viewBox="0 0 24 24" stroke-width="2.2">${p}</svg>` : '')(
    /sport/.test(t)
      ? '<circle cx="12" cy="12" r="10"/><path d="M6 5.3a9 9 0 0 1 0 13.4M18 5.3a9 9 0 0 0 0 13.4"/>'
      : /sök|sok|search/.test(t)
      ? '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>'
      : /nyhet|news/.test(t)
      ? '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M18 10h-8"/><path d="M10 6h6"/>'
      : /kontakt|om|contact|about/.test(t)
      ? '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'
      : /hem|home|start/.test(t)
      ? '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'
      : ''
  ),
  o = location.origin,
  st = new Set();

  $(':is(header,nav,[role=banner],[class*="header" i],[class*="nav" i],[id*="header" i],[id*="nav" i]) a').forEach(a => {
    let h = a.href, t = (a.textContent + a.getAttribute('aria-label')).toLowerCase();
    if (h && !h.startsWith('jav') && !h.includes('#')) {
      try {
        let u = new URL(h);
        if (u.origin === o && !st.has(h) && u.pathname.split('/').filter(Boolean).length <= 1) {
          st.add(h);
          let n = document.createElement('a'), ic = g(t);
          n.href = h;
          n._el = a;
          ic ? n.innerHTML = ic : n.textContent = a.textContent.trim() || 'Länk';
          d.append(n);
        }
      } catch {}
    }
  });

  document.body.appendChild(d);
})();
